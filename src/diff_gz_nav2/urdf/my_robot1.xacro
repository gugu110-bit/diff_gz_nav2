<?xml version="1.0"?>
<robot name="my_robot1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 底盘 -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.05 -0.05 0.00" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="$(find diff_gz_nav2)/model/body.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="write">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 1.5708"/>
      <geometry>
        <box size="0.1 0.08 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.0" rpy="0 0 0"/> 
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- 左轮 -->
  <link name="lw_link">
    <visual>
      <origin xyz="-0.009 -0.0215 -0.0215" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="$(find diff_gz_nav2)/model/wheel.STL" scale="0.001 0.001 0.001 "/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 1.57 0.0"/>
      <geometry>
        <cylinder radius="0.021" length="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.0" rpy="0 0 0"/> 
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- 右轮 -->
  <link name="rw_link">
    <visual>
      <origin xyz="-0.009 -0.0215 -0.0215" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="$(find diff_gz_nav2)/model/wheel.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 0.0"/>
      <geometry>
        <cylinder radius="0.021" length="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.0" rpy="0 0 0"/> 
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

   <!-- wanxiang -->
  <link name="w_link">
    <visual>
      <origin xyz="-0.006 -0.006 -0.006" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="$(find diff_gz_nav2)/model/ball.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.0 -0.0 -0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere  radius="0.006"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.0" rpy="0 0 0"/> 
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- 左轮关节 -->
  <joint name="left_wheel" type="continuous">
    <parent link="base_link"/><child link="lw_link"/>
    <origin xyz="-0.05 0 0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
  </joint>

  <!-- 右轮关节 -->
  <joint name="right_wheel" type="continuous">
    <parent link="base_link"/><child link="rw_link"/>
    <origin xyz="0.05 0 0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
  </joint>

  <joint name="w_joint" type="fixed">
    <parent link="base_link"/><child link="w_link"/>
    <origin xyz="0.00 0.046 0.003" rpy="0 0 0"/><axis xyz="0 0 0"/>
  </joint>


<ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        <namespace>$(arg namespace)</namespace>
      </ros>
      <parameters>$(find my_robot_bringup)/config/diff_control.yaml</parameters>
    </plugin>
  </gazebo>
  
</robot>